# Local pacman package for Arch-based systems (Arch, CachyOS, …).
# Packages the binary built by `tauri build --no-bundle`; run `pnpm release:arch`
# from the repo root (makepkg --nodeps: the dependencies are for the machine that installs it,
# not the one that builds it), then `sudo pacman -U packaging/arch/cloudy-launcher-*.pkg.tar.zst`.
# Installed this way, pacman owns the launcher: it tells you about new versions and opens the
# release page, where the new package is.

_root="$startdir/../.."
_tauri="$_root/src-tauri"

pkgname=cloudy-launcher
pkgver=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "$_tauri/tauri.conf.json")
pkgrel=1
pkgdesc="Cloudy Launcher — install and update the Cloudy apps"
arch=('x86_64')
url="https://github.com/Cloudy-Studio-Apps/cloudy-launcher"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'hicolor-icon-theme')
optdepends=('fuse2: run the apps it installs, which are AppImages')
options=('!strip' '!debug')

package() {
  install -Dm755 "$_tauri/target/release/cloudy-launcher" "$pkgdir/usr/bin/cloudy-launcher"

  install -Dm644 "$startdir/cloudy-launcher.desktop" "$pkgdir/usr/share/applications/cloudy-launcher.desktop"

  local icons="$_tauri/icons" share="$pkgdir/usr/share/icons/hicolor"
  install -Dm644 "$icons/32x32.png" "$share/32x32/apps/cloudy-launcher.png"
  install -Dm644 "$icons/128x128.png" "$share/128x128/apps/cloudy-launcher.png"
  install -Dm644 "$icons/128x128@2x.png" "$share/256x256/apps/cloudy-launcher.png"
  install -Dm644 "$icons/icon.png" "$share/512x512/apps/cloudy-launcher.png"
}
