{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudy Launcher",
  "version": "0.1.0",
  "identifier": "com.darkredgm.cloudylauncher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloudy Launcher",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Install and update the Cloudy apps"
  }
}
